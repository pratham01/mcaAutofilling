{
  "name": "formmind-agentic-system",
  "version": "1.0.0",
  "description": "Multi-agent form automation, validation, interactive fallback mapping, and iterative learning platform",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "tsx server/index.ts",
    "dev:all": "concurrently -n SERVER,CLIENT -c cyan,magenta \"node --import tsx/esm server/index.ts\" \"npx.cmd vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "tsx server/index.ts",
    "aoc4:automate": "node aoc4_playwright_runner.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
